# ---------- Core ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Acme SaaS"
# Must be a NON-superuser role without BYPASSRLS so Row-Level Security is enforced (see docker/postgres/init.sql)
DATABASE_URL=postgresql://app:app@localhost:5432/saas

# ---------- Auth (Better Auth) ----------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Comma-separated emails that become super-admins on sign up
ADMIN_EMAILS=admin@example.com
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Optional OAuth providers (enabled automatically when set)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Email ----------
EMAIL_FROM="Acme SaaS <noreply@example.com>"
# Local: Mailpit from docker-compose (inbox at http://localhost:8025)
SMTP_URL=smtp://localhost:1025
# Production: set RESEND_API_KEY to send via Resend instead of SMTP
RESEND_API_KEY=

# ---------- Background jobs (pg-boss) ----------
# queue  = jobs are processed by `npm run worker` (default)
# inline = jobs run in the request (serverless hosts without a worker)
JOBS_MODE=queue

# ---------- Billing (Stripe) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# ---------- File storage (any S3-compatible service) ----------
S3_ENDPOINT=http://localhost:9000
# URL browsers use to reach storage (defaults to S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_BUCKET=uploads
S3_FORCE_PATH_STYLE=true

# ---------- Observability ----------
LOG_LEVEL=info
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
